rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function staff() {
      return request.auth != null && exists(/databases/$(db)/documents/staff/$(request.auth.uid));
    }
    // Contenu public du site (sans comptes ni mots de passe)
    match /site/config { allow read: if true; allow write: if staff(); }
    // Comptes du manager : réservé à l'équipe
    match /site/private { allow read, write: if staff(); }
    // Photos
    match /media/{id} { allow read: if true; allow write: if staff(); }
    // Statistiques : les visiteurs ne peuvent qu'incrémenter des compteurs
    match /stats/{day} {
      allow read: if staff();
      allow create, update: if staff() || (request.resource.data.keys().hasOnly(['day','views','visitors','clicks','pages','ev']) && request.resource.data.day == day);
    }
    // Activité du manager
    match /mstats/{day} { allow read, write: if staff(); }
    // Personnel autorisé : documents créés à la main dans la console (ID = UID du compte)
    match /staff/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
